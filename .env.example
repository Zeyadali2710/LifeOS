# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# Postgres. Dev: docker/compose.dev.yml publishes on localhost:5433.
# In docker/compose.yml the host is "db".
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lifeos
# Dev (compose.dev.yml) credentials are lifeos/lifeos. Prod compose builds its own URL from POSTGRES_*.
DATABASE_URL=postgres://lifeos:lifeos@localhost:5433/lifeos

# Better Auth. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public URL the browser uses. Prod: https://lifeos.<tailnet>.ts.net
BETTER_AUTH_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts integration tokens at rest. Back it up separately.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LIFEOS_MASTER_KEY=

# Prod only (docker/compose.yml): Tailscale auth key (reusable=false, tagged)
TS_AUTHKEY=
